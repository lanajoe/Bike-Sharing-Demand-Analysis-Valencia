import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error, r2_score

# 1. Carga del conjunto de datos procesado de La Seu
df = pd.read_csv("usobarriosmeteo_processed.csv", sep=";")
# Variable objetivo común para ambos experimentos
y = df['uso_bici']

# =====================================================================
# METRICA BASE DE REFERENCIA (BASELINE)
# =====================================================================
# Predicción ingenua usando la media global de uso_bici
prediccion_base = np.full(shape=len(df), fill_value=df['uso_bici'].mean())
mae_baseline = mean_absolute_error(y, prediccion_base)
print(f"Métrica Base (MAE Baseline - Predicción usando la media): {mae_baseline:.2f}\n")

# =====================================================================
# EXPERIMENTO 1: Modelo con 2 variables cuantitativas básicas
# =====================================================================
X1 = df[['hora_dia', 'ta']]

# División de datos (80% entrenamiento, 20% prueba)
X1_train, X1_test, y1_train, y1_test = train_test_split(X1, y, test_size=0.2, random_state=42)

# Entrenamiento del Modelo 1
modelo1 = LinearRegression()
modelo1.fit(X1_train, y1_train)

# Predicción y cálculo de métricas para el Experimento 1
pred1 = modelo1.predict(X1_test)
mae_1 = mean_absolute_error(y1_test, pred1)
r2_1 = r2_score(y1_test, pred1)

print("RESULTADOS EXPERIMENTO 1 ")
print(f"Variables usadas: ['hora_dia', 'ta']")
print(f"Error Medio Absoluto (MAE): {mae_1:.2f}")
print(f"Coeficiente de Determinación (R2): {r2_1:.2f}\n")

# Gráfica de resultado Experimento 1
plt.figure(figsize=(6, 4))
sns.scatterplot(x=y1_test, y=pred1, alpha=0.6, color='blue')
plt.plot([y1_test.min(), y1_test.max()], [y1_test.min(), y1_test.max()], 'r--', lw=2)
plt.title('Experimento 1: Reales vs Predichos')
plt.xlabel('Valores Reales (uso_bici)')
plt.ylabel('Predicciones del Modelo')
plt.grid(True, linestyle='--')
plt.savefig("grafico_exp1.png", dpi=300)
plt.show()

# =====================================================================
# EXPERIMENTO 2: Modelo Expandido (Añadimos es_fin_semana y prec)
# =====================================================================
X2 = df[['hora_dia', 'ta', 'es_fin_semana', 'prec']]

# División de datos (Mismo reparto 80% entrenamiento, 20% prueba)
X2_train, X2_test, y2_train, y2_test = train_test_split(X2, y, test_size=0.2, random_state=42)

# Entrenamiento del Modelo 2
modelo2 = LinearRegression()
modelo2.fit(X2_train, y2_train)

# Predicción y cálculo de métricas para el Experimento 2
pred2 = modelo2.predict(X2_test)
mae_2 = mean_absolute_error(y2_test, pred2)
r2_2 = r2_score(y2_test, pred2)

print(" RESULTADOS EXPERIMENTO 2 ")
print(f"Variables usadas: ['hora_dia', 'ta', 'es_fin_semana', 'prec']")
print(f"Error Medio Absoluto (MAE): {mae_2:.2f}")
print(f"Coeficiente de Determinación (R2): {r2_2:.2f}\n")

# Gráfica de resultado Experimento 2
plt.figure(figsize=(6, 4))
sns.scatterplot(x=y2_test, y=pred2, alpha=0.6, color='green')
plt.plot([y2_test.min(), y2_test.max()], [y2_test.min(), y2_test.max()], 'r--', lw=2)
plt.title('Experimento 2: Reales vs Predichos')
plt.xlabel('Valores Reales (uso_bici)')
plt.ylabel('Predicciones del Modelo')
plt.grid(True, linestyle='--')
plt.savefig("grafico_exp2.png", dpi=300)
plt.show()
