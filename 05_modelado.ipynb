    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.metrics import mean_absolute_error, r2_score\n",
    "\n",
    "# 1. Carga del conjunto de datos procesado de La Seu\n",
    "df = pd.read_csv("usobarriosmeteo_processed.csv", sep=";")\n",
    "\n",
    "# Variable objetivo común para ambos experimentos\n",
    "y = df['uso_bici']\n",
    "\n",
    "# =====================================================================\n",
    "# METRICA BASE DE REFERENCIA (BASELINE)\n",
    "# =====================================================================\n",
    "# Predicción ingenua usando la media global de uso_bici\n",
    "prediccion_base = np.full(shape=len(df), fill_value=df['uso_bici'].mean())\n",
    "mae_baseline = mean_absolute_error(y, prediccion_base)\n",
    "print(f\"Métrica Base (MAE Baseline - Predicción usando la media): {mae_baseline:.2f}\\n\")\n",
    "\n",
    "# =====================================================================\n",
    "# EXPERIMENTO 1: Modelo con 2 variables cuantitativas básicas\n",
    "# =====================================================================\n",
    "X1 = df[['hora_dia', 'ta']]\n",
    "\n",
    "# División de datos (80% entrenamiento, 20% prueba)\n",
    "X1_train, X1_test, y1_train, y1_test = train_test_split(X1, y, test_size=0.2, random_state=42)\n",
    "\n",
    "# Entrenamiento del Modelo 1\n",
    "modelo1 = LinearRegression()\n",
    "modelo1.fit(X1_train, y1_train)\n",
    "\n",
    "# Predicción y cálculo de métricas para el Experimento 1\n",
    "pred1 = modelo1.predict(X1_test)\n",
    "mae_1 = mean_absolute_error(y1_test, pred1)\n",
    "r2_1 = r2_score(y1_test, pred1)\n",
    "\n",
    "print(\"RESULTADOS EXPERIMENTO 1 \")\n",
    "print(f\"Variables usadas: ['hora_dia', 'ta']\")\n",
    "print(f\"Error Medio Absoluto (MAE): {mae_1:.2f}\")\n",
    "print(f\"Coeficiente de Determinación (R2): {r2_1:.2f}\\n\")\n",
    "\n",
    "# Gráfica de resultado Experimento 1\n",
    "plt.figure(figsize=(6, 4))\n",
    "sns.scatterplot(x=y1_test, y=pred1, alpha=0.6, color='blue')\n",
    "plt.plot([y1_test.min(), y1_test.max()], [y1_test.min(), y1_test.max()], 'r--', lw=2)\n",
    "plt.title('Experimento 1: Reales vs Predichos')\n",
    "plt.xlabel('Valores Reales (uso_bici)')\n",
    "plt.ylabel('Predicciones del Modelo')\n",
    "plt.grid(True, linestyle='--')\n",
    "plt.savefig('grafico_exp1.png', dpi=300)",
    "plt.show()\n",
    "\n",
    "# =====================================================================\n",
    "# EXPERIMENTO 2: Modelo Expandido (Añadimos es_fin_semana y prec)\n",
    "# =====================================================================\n",
    "X2 = df[['hora_dia', 'ta', 'es_fin_semana', 'prec']]\n",
    "\n",
    "# División de datos (Mismo reparto 80% entrenamiento, 20% prueba)\n",
    "X2_train, X2_test, y2_train, y2_test = train_test_split(X2, y, test_size=0.2, random_state=42)\n",
    "\n",
    "# Entrenamiento del Modelo 2\n",
    "modelo2 = LinearRegression()\n",
    "modelo2.fit(X2_train, y2_train)\n",
    "\n",
    "# Predicción y cálculo de métricas para el Experimento 2\n",
    "pred2 = modelo2.predict(X2_test)\n",
    "mae_2 = mean_absolute_error(y2_test, pred2)\n",
    "r2_2 = r2_score(y2_test, pred2)\n",
    "\n",
    "print(\" RESULTADOS EXPERIMENTO 2 \")\n",
    "print(f\"Variables usadas: ['hora_dia', 'ta', 'es_fin_semana', 'prec']\")\n",
    "print(f\"Error Medio Absoluto (MAE): {mae_2:.2f}\")\n",
    "print(f\"Coeficiente de Determinación (R2): {r2_2:.2f}\\n\")\n",
    "\n",
    "# Gráfica de resultado Experimento 2\n",
    "plt.figure(figsize=(6, 4))\n",
    "sns.scatterplot(x=y2_test, y=pred2, alpha=0.6, color='green')\n",
    "plt.plot([y2_test.min(), y2_test.max()], [y2_test.min(), y2_test.max()], 'r--', lw=2)\n",
    "plt.title('Experimento 2: Reales vs Predichos')\n",
    "plt.xlabel('Valores Reales (uso_bici)')\n",
    "plt.ylabel('Predicciones del Modelo')\n",
    "plt.grid(True, linestyle='--')\n",
    "plt.savefig('grafico_exp2.png', dpi=300)",
    "plt.show()"
   ]
  }
